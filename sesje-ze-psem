<script src="https://cdn.jsdelivr.net/npm/@emailjs/browser@4/dist/email.min.js"></script>
<script>
const EMAILJS_PUBLIC_KEY='8sKwmAvy4Jw0ot0W4',EMAILJS_SERVICE_ID='service_47o5cwb',EMAILJS_TEMPLATE_DOG='template_p9bnrqz';
emailjs.init({publicKey:EMAILJS_PUBLIC_KEY});
document.getElementById('dogForm').addEventListener('submit',async function(e){
  e.preventDefault();const btn=document.getElementById('dogSubmitBtn'),msg=document.getElementById('dogFormMsg');
  btn.disabled=true;msg.style.display='none';
  try{await emailjs.send(EMAILJS_SERVICE_ID,EMAILJS_TEMPLATE_DOG,{dog_name:document.getElementById('dname').value,breed:document.getElementById('breed').value,email:document.getElementById('f_email').value,phone:document.getElementById('f_phone').value,message:document.getElementById('msg').value});
  msg.textContent='Wiadomość wysłana! Alex odpowie wkrótce.';msg.className='form-msg success';msg.style.display='block';this.reset();
  }catch(err){msg.textContent='Błąd wysyłki. Napisz na alex.sevoz.photo@gmail.com.';msg.className='form-msg error';msg.style.display='block';}
  btn.disabled=false;
});
const io=new IntersectionObserver(entries=>{entries.forEach(e=>{if(e.isIntersecting)e.target.classList.add('visible');});},{threshold:0.1});
const dogPhotos=[
  {src:'images/dog/Portfolio-1.webp',alt:'Pies skaczący w powietrzu — Alex Sevoz'},
  {src:'images/dog/Protfolio-2.webp',alt:'Zdjęcie akcji psa w locie'},
  {src:'images/dog/Portfolio-3.webp',alt:'Fotografia psa w skoku Poznań'},
  {src:'images/dog/Protfolio-4.webp',alt:'Border collie w locie'},
  {src:'images/dog/Portfolio-5.webp',alt:'Pies łapiący frisbee'},
  {src:'images/dog/Portfolio-10.webp',alt:'Fotografia psów akcja Polska'},
  {src:'images/dog/Portfolio-8.webp',alt:'Pies w szczycie skoku'},
  {src:'images/dog/Portfolio-7.webp',alt:'Sesja flying dog'},
  {src:'images/dog/Portfolio-6.webp',alt:'Portret psa w locie'},
];
const grid=document.getElementById('portfolioGrid');
dogPhotos.forEach((photo,i)=>{
  const fig=document.createElement('figure');fig.classList.add('reveal');
  const img=document.createElement('img');img.src=photo.src;img.alt=photo.alt;img.loading='lazy';img.width=900;img.height=600;
  fig.appendChild(img);fig.addEventListener('click',()=>openLightbox(i));grid.appendChild(fig);io.observe(fig);
});
const lightbox=document.getElementById('lightbox'),lbImg=document.getElementById('lbImg'),lbCounter=document.getElementById('lbCounter');
let lbIndex=0;
function openLightbox(i){lbIndex=i;lbImg.src=dogPhotos[i].src;lbImg.alt=dogPhotos[i].alt;lbCounter.textContent=(i+1)+' / '+dogPhotos.length;lightbox.classList.add('open');document.body.style.overflow='hidden';}
function closeLightbox(){lightbox.classList.remove('open');document.body.style.overflow='';}
function lbMove(dir){lbIndex=(lbIndex+dir+dogPhotos.length)%dogPhotos.length;lbImg.src=dogPhotos[lbIndex].src;lbImg.alt=dogPhotos[lbIndex].alt;lbCounter.textContent=(lbIndex+1)+' / '+dogPhotos.length;}
document.getElementById('lbClose').addEventListener('click',closeLightbox);
document.getElementById('lbPrev').addEventListener('click',()=>lbMove(-1));
document.getElementById('lbNext').addEventListener('click',()=>lbMove(1));
lightbox.addEventListener('click',e=>{if(e.target===lightbox)closeLightbox();});
document.addEventListener('keydown',e=>{if(!lightbox.classList.contains('open'))return;if(e.key==='Escape')closeLightbox();if(e.key==='ArrowLeft')lbMove(-1);if(e.key==='ArrowRight')lbMove(1);});
const nav=document.getElementById('nav');
window.addEventListener('scroll',()=>nav.classList.toggle('scrolled',window.scrollY>40));
const navToggle=document.getElementById('navToggle'),navLinks=document.getElementById('navLinks'),mobileLang=document.getElementById('langSwitchMobile');
navToggle.addEventListener('click',()=>{const open=navLinks.classList.toggle('open');mobileLang.classList.toggle('open',open);navToggle.textContent=open?'✕':'☰';});
function closeMenu(){navLinks.classList.remove('open');mobileLang.classList.remove('open');navToggle.textContent='☰';}
document.querySelectorAll('.reveal').forEach(el=>io.observe(el));
const track=document.getElementById('testiTrack'),testiNav=document.getElementById('testiNav'),total=track.children.length;
let current=0;
for(let i=0;i<total;i++){const dot=document.createElement('button');dot.className='testi-dot'+(i===0?' active':'');dot.addEventListener('click',()=>goTo(i));testiNav.appendChild(dot);}
function goTo(i){current=i;const pct=(100/total)*i;track.style.transform=`translateX(-${pct}%)`;[...testiNav.children].forEach((d,idx)=>d.classList.toggle('active',idx===i));}
setInterval(()=>goTo((current+1)%total),6000);
</script>
